sdkconfig
sdkconfig.*
!sdkconfig.defaults

# ---- Runtime output ------------------------------------------------------
*.log
telemetry.log

# ---- Windows / WSL download markers --------------------------------------
*Zone.Identifier*
*Zone*Identifier*

# ---- Editors, caches, OS -------------------------------------------------
.vscode/
.idea/
.cache/
.clangd/
__pycache__/
*.pyc
.DS_Store
Thumbs.db
# ---- Additional Editor & Swap Files --------------------------------------
*.swp
*.swo
*~
*.tmp
*.bak

